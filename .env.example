TRASE_CSV_PATH=data/raw/brazil_beef.csv
TRASE_TABLE_NAME=supply_chain
DUCKDB_PATH=data/processed/trase.duckdb

# PostgreSQL + pgvector (camada documental)
PG_HOST=localhost
PG_PORT=5433
PG_USER=rag
PG_PASSWORD=troque-esta-senha
PG_DATABASE=trase_rag

# Embeddings: EMBEDDING_DIM precisa bater com o modelo escolhido.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# Configuração do full-text do Postgres (stemming em português: leis e perguntas em PT).
FTS_CONFIG=portuguese

# LLM via OpenRouter (endpoint compatível com a API da Anthropic)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api
LLM_MODEL=anthropic/claude-haiku-5.5
