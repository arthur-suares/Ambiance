# Camada tabular: Parquet (fonte) -> DuckDB (gerado por `python -m src.cli build-db`)
PARQUET_DIR=data/processed/parquet
SUPPLY_CHAIN_FILE=brazil_beef_v2_2_2.parquet
SPATIAL_METRICS_GLOB=spatial-metrics-brazil-beef-*.parquet
FACILITIES_GLOB=*br_beef_logistics_map*.parquet
DUCKDB_PATH=data/processed/trase.duckdb
# Limites do SQL gerado pelo LLM
SQL_TIMEOUT_SECONDS=20
SQL_MAX_ROWS=200

# PostgreSQL + pgvector (camada documental)
PG_HOST=localhost
PG_PORT=5433
PG_USER=rag
PG_PASSWORD=troque-esta-senha
PG_DATABASE=trase_rag
PG_CONNECT_TIMEOUT=5

# Embeddings: EMBEDDING_DIM precisa bater com o modelo escolhido.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# Configuração do full-text do Postgres (stemming em português: leis e perguntas em PT).
FTS_CONFIG=portuguese

# LLM via OpenRouter (endpoint compatível com a API da Anthropic)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api
LLM_MODEL=anthropic/claude-haiku-5.5
